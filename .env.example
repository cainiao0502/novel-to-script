# ======= LLM（OpenAI 兼容） =======
# 把这份 .env.example 复制为 .env，然后填 APP_LLM_API_KEY
#
# 官方 OpenAI
APP_LLM_BASE_URL=https://api.openai.com/v1
# 也可指向代理/中转，例如：
# APP_LLM_BASE_URL=https://your-proxy.example.com/v1
APP_LLM_API_KEY=sk-REPLACE_ME
APP_LLM_MODEL=gpt-4o-mini

# ======= MinerU PDF 解析（精准解析 API） =======
# 去 https://mineru.net 注册账号，在个人中心获取 Token
# 用于 V4 URL 解析模式；Agent 文件上传模式无需 Token
MINERU_API_BASE_URL=https://mineru.net
MINERU_API_TOKEN=REPLACE_ME
