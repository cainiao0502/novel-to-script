{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-to-script.local/json-schema/script-v1.0.schema.json",
  "title": "ScriptYAML",
  "description": "AI-generated film/TV/short-drama script in YAML format (v1.0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "meta", "characters", "scenes"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title":         { "type": "string", "minLength": 1, "maxLength": 128 },
        "source_novel":  { "type": "string", "maxLength": 256 },
        "episode":       { "type": "integer", "minimum": 0 },
        "genre":         { "type": "string", "maxLength": 64 },
        "logline":       { "type": "string", "maxLength": 500 },
        "total_scenes":  { "type": "integer", "minimum": 0 },
        "generated_at":  { "type": "string", "format": "date-time" }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Character" }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Scene" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "maxLength": 1000 }
    }
  },
  "$defs": {
    "Character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role"],
      "properties": {
        "id":         { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "name":       { "type": "string", "minLength": 1, "maxLength": 32 },
        "aliases":    { "type": "array", "items": { "type": "string", "maxLength": 32 } },
        "gender":     { "type": "string", "enum": ["男", "女", "其他"] },
        "age_range":  { "type": "string", "maxLength": 16 },
        "role":       { "type": "string", "enum": ["protagonist", "antagonist", "supporting", "npc"] },
        "appearance": { "type": "string", "maxLength": 200 },
        "voice":      { "type": "string", "maxLength": 100 }
      }
    },
    "Scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_id", "chapter", "order",
        "int_ext", "location", "time_of_day",
        "characters", "summary", "actions", "dialogues"
      ],
      "properties": {
        "scene_id":     { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "chapter":      { "type": "integer", "minimum": 1 },
        "order":        { "type": "integer", "minimum": 1 },
        "int_ext":      { "type": "string", "enum": ["INT", "EXT", "INT-EXT"] },
        "location":     { "type": "string", "minLength": 1, "maxLength": 64 },
        "time_of_day":  { "type": "string", "enum": ["DAY", "NIGHT", "DAWN", "DUSK", "CONTINUOUS"] },
        "characters":   { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "summary":      { "type": "string", "minLength": 1, "maxLength": 200 },
        "actions":      { "type": "array", "items": { "type": "string", "maxLength": 200 } },
        "dialogues":    { "type": "array", "items": { "$ref": "#/$defs/Dialogue" } },
        "voiceover":    { "type": "array", "items": { "$ref": "#/$defs/Voiceover" } },
        "props":        { "type": "array", "items": { "type": "string", "maxLength": 32 } },
        "sfx":          { "type": "array", "items": { "type": "string", "maxLength": 32 } },
        "music_cue":    { "type": "string", "maxLength": 100 },
        "camera_hint":  { "type": "string", "maxLength": 200 }
      }
    },
    "Dialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character", "line"],
      "properties": {
        "character":     { "type": "string" },
        "parenthetical": { "type": "string", "pattern": "^[（][^）]{0,100}[）]$" },
        "line":          { "type": "string", "minLength": 1, "maxLength": 300 },
        "emotion":       { "type": "string", "maxLength": 16 }
      }
    },
    "Voiceover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character", "line"],
      "properties": {
        "character": { "type": "string" },
        "line":      { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
